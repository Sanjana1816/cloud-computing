rules_version = '2';

// roles:
//   passenger - read routes/buses/live/alerts, change own stop
//   driver  - same + write location of their own bus (only after admin verifies them)
//   admin   - manage everything

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function isVerifiedDriverOf(busId) {
      return hasProfile() && me().role == 'driver' && me().approved == true && me().busId == busId;
    }
    function validLocation(d) {
      return d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.active is bool
          && d.clientTs is number;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // sign up as passenger or unverified driver only (never admin)
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['passenger', 'driver']
        && request.resource.data.approved == (request.resource.data.role == 'passenger')
        && request.resource.data.busId == null
        && request.resource.data.email == request.auth.token.email;

      // users can only change name + homeStop. role/approved/busId = admin only
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeStop', 'name']));

      allow delete: if isAdmin();
    }

    // ---------- static fleet data ----------
    match /routes/{routeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /buses/{busId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- live bus locations ----------
    match /live/{busId} {
      allow read: if signedIn();
      allow create, update: if validLocation(request.resource.data) && (
        isAdmin()
        || (isVerifiedDriverOf(busId) && request.resource.data.driverId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // ---------- trip history ----------
    match /trips/{tripId} {
      allow read: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.driverId == request.auth.uid
        && (isAdmin() || isVerifiedDriverOf(request.resource.data.busId));
      allow update: if signedIn() && (isAdmin() || resource.data.driverId == request.auth.uid)
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.busId == resource.data.busId;
      allow delete: if isAdmin();
    }

    // ---------- broadcast alerts ----------
    match /alerts/{alertId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 200
        && request.resource.data.severity in ['info', 'warning', 'critical'];
      allow update, delete: if isAdmin();
    }

    // ---------- presence (who is online) ----------
    match /presence/{uid} {
      allow read: if isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- audit log (only cloud functions write this) ----------
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
